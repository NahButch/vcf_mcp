# Rust build output (anywhere a cargo invocation might land it)
target/
target-*/
**/*.rs.bk
Cargo.lock.bak

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Local config (may contain absolute paths to user data)
/config.toml
config.local.toml

# Downloaded reference data (committed tables + slices are kept; raw dumps ignored)
data/raw/
data/ensembl/
*.vcf.gz
*.vcf.gz.tbi
*.gtf.gz
*.bam
*.bai
*.cram
*.crai
*.fastq
*.fastq.gz
!tests/data/**/*.vcf.gz
!tests/data/**/*.vcf.gz.tbi

# Server-persisted state (normally lives in %APPDATA% / ~/.local; ignore here too)
state.json

# Local working / scratch docs that may contain absolute paths
docs/todo.html

# Git history-rewrite backup bundles (must never be re-committed)
*.bundle

# Coverage / profiling
*.profraw
tarpaulin-report.html
cobertura.xml

# Env files
.env
.env.local

# Temporary commit-message scratch files (used by the PowerShell heredoc
# workaround when piping multi-line messages to `git commit -F`).
.commit-msg.tmp
