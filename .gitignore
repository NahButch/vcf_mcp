data/raw/
data/ensembl/
*.vcf.gz
*.vcf.gz.tbi
*.gtf.gz
!tests/data/**/*.vcf.gz
!tests/data/**/*.vcf.gz.tbi

# Coverage / profiling
*.profraw
tarpaulin-report.html
cobertura.xml

# Env files
.env
.env.local
